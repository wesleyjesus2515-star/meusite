@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<style>
.card-veiculo {
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 15px;
    margin-bottom: 20px;
    background: #fff;
}

.card-veiculo img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    margin-bottom: 10px;
}

.titulo {
    font-weight: bold;
}

.info {
    color: #666;
}

.preco {
    font-weight: bold;
    color: green;
}
</style>

<div class="container mt-4">
    <div class="row">

        <div class="col-md-4">
            <div class="card-veiculo">

                <!-- IMAGEM CORRIGIDA -->
                <img src="/imagens/utilitarios.jpg" alt="">

                <div class="titulo">Fiat Fiorino 1.4 Furgão</div>
                <div class="info">2024/2025 • Branco • 30.293 Km • Flex</div>
                <div class="info">Campinas - SP</div>
                <div class="preco">R$ 109.290,00</div>

            </div>
        </div>

    </div>
</div>